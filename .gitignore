# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/
**/out/

# production
/build

# python (services/orbital-engine)
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*

# claude
.claude
.agents

# graphify
/graphify-out/cache
.graphify*
.graphify_python
.graphifyignore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cesium files that gets copied over by copy webpack plugin
/public/cesium
apps/web/public/cesium

# fonts
/public/fonts
apps/web/public/fonts
