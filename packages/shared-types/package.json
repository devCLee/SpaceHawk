{
  "name": "@spacehawk/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript contract for the Orbital Engine API, shared by the web tier.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/orbital-engine.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5"
  }
}
