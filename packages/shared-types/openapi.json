{
  "openapi": "3.1.0",
  "info": {
    "title": "SpaceHawk Orbital Engine",
    "description": "SpaceHawk Orbital Engine \u2014 internal domain/compute API (ingestion, catalog, propagation, screening, analytics). Reached only by the web/BFF tier over a private network; never serves HTML.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service information",
        "operationId": "service_info__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Current catalog",
        "operationId": "get_catalog_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CatalogObject"
                  },
                  "type": "array",
                  "title": "Response Get Catalog Catalog Get"
                }
              }
            }
          }
        }
      }
    },
    "/ingest/run": {
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Trigger Celestrak ingest",
        "operationId": "run_ingest_ingest_run_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          }
        }
      }
    },
    "/state/latest": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Latest propagated state",
        "operationId": "get_latest_state_state_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestState"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/stream": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Alert stream (SSE)",
        "operationId": "alerts_stream_alerts_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogObject": {
        "properties": {
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "norad_cat_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Norad Cat Id"
          },
          "object_name": {
            "type": "string",
            "title": "Object Name"
          },
          "object_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Type"
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "tle_line0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tle Line0"
          },
          "tle_line1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tle Line1"
          },
          "tle_line2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tle Line2"
          }
        },
        "type": "object",
        "required": [
          "object_id",
          "object_name"
        ],
        "title": "CatalogObject"
      },
      "IngestResult": {
        "properties": {
          "written": {
            "type": "integer",
            "title": "Written"
          }
        },
        "type": "object",
        "required": [
          "written"
        ],
        "title": "IngestResult"
      },
      "LatestState": {
        "properties": {
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/StateObject"
            },
            "type": "array",
            "title": "Objects"
          }
        },
        "type": "object",
        "title": "LatestState"
      },
      "Liveness": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/LivenessStatus",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Liveness"
      },
      "LivenessStatus": {
        "type": "string",
        "enum": [
          "ok"
        ],
        "title": "LivenessStatus"
      },
      "Readiness": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks",
            "description": "Per-dependency readiness (e.g. postgres, redis). Empty until wired up."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Readiness"
      },
      "ReadinessStatus": {
        "type": "string",
        "enum": [
          "ready",
          "not_ready"
        ],
        "title": "ReadinessStatus"
      },
      "ServiceInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "environment"
        ],
        "title": "ServiceInfo"
      },
      "StateObject": {
        "properties": {
          "object_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Id"
          },
          "object_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Name"
          },
          "lat_deg": {
            "type": "number",
            "title": "Lat Deg"
          },
          "lon_deg": {
            "type": "number",
            "title": "Lon Deg"
          },
          "alt_km": {
            "type": "number",
            "title": "Alt Km"
          }
        },
        "type": "object",
        "required": [
          "lat_deg",
          "lon_deg",
          "alt_km"
        ],
        "title": "StateObject"
      }
    }
  }
}
