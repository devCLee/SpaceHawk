# Copy to services/orbital-engine/.env and fill in. All keys take the
# ORBITAL_ENGINE_ prefix (see orbital_engine/config.py). No secret is committed;
# the defaults below are dev-only and MUST be overridden in any shared/enclave env.

# --- Runtime ---
ORBITAL_ENGINE_ENVIRONMENT=development        # development | staging | production
ORBITAL_ENGINE_LOG_LEVEL=info
ORBITAL_ENGINE_LOG_JSON=false

# --- Datastores ---
ORBITAL_ENGINE_DATABASE_URL=postgresql+psycopg://spacehawk:spacehawk@localhost:5432/spacehawk
ORBITAL_ENGINE_REDIS_URL=redis://localhost:6379/0

# --- Access control / sessions (Stage 5) ---
# REQUIRED in production: a high-entropy secret of at least 32 bytes. The engine
# refuses to start in production if this is unset/default/too short.
ORBITAL_ENGINE_AUTH_JWT_SECRET=change-me-to-a-32+-byte-random-secret
ORBITAL_ENGINE_AUTH_SESSION_TTL_SEC=28800
ORBITAL_ENGINE_AUTH_COOKIE_NAME=sh_session
# Comma/JSON list of hosts allowed to perform ADMINISTER actions (empty = off).
ORBITAL_ENGINE_ADMIN_IP_ALLOWLIST=[]
# Tri-service MOU governance grant for cross-service reads.
ORBITAL_ENGINE_CROSS_SERVICE_ALLOWED=false
# Dev-only password used by the seed script (security/seed.py).
ORBITAL_ENGINE_SEED_PASSWORD=changeme

# --- Source credentials (unset => the adapter is skipped) ---
ORBITAL_ENGINE_SPACETRACK_IDENTITY=
ORBITAL_ENGINE_SPACETRACK_PASSWORD=
ORBITAL_ENGINE_DISCOS_API_TOKEN=
ORBITAL_ENGINE_LEOLABS_API_KEY=
ORBITAL_ENGINE_LEOLABS_API_SECRET=
