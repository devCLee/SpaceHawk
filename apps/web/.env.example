# Copy to apps/web/.env and fill in. Loaded by Next.js (runs in apps/web).
# Only required for the ONLINE globe mode (Cesium Ion world imagery + terrain +
# OSM Buildings). The default OFFLINE mode needs no token and no internet.
NEXT_PUBLIC_CESIUM_TOKEN=

# Private address of the Orbital Engine (the Python compute tier). The BFF is the
# only thing that talks to it; the browser never holds this. Defaults to
# http://localhost:8000 for local dev.
ORBITAL_ENGINE_URL=http://localhost:8000
